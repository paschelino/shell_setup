// Zellij config, modelled on ~/.tmux.conf: everything goes through the prefix
// Ctrl-a, so no other key combination is taken away from nvim, zsh or the
// coding agents (Zellij's defaults grab Ctrl-p, Ctrl-n, Ctrl-o, Ctrl-s, ...).
// Full reference: `zellij setup --dump-config`

theme "catppuccin-mocha"
default_shell "zsh"
// Tab bar plus status bar, which lists the keys of the current mode
default_layout "base"
pane_frames false
mouse_mode true
copy_command "pbcopy"
scroll_buffer_size 50000
// nvim opens the scrollback (Ctrl-a e) for vi-style search and copy
scrollback_editor "nvim"
show_startup_tips false
show_release_notes false
// Sessions survive a reboot and can be resurrected with `zellij attach`
session_serialization true

keybinds clear-defaults=true {
    normal {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    tmux {
        bind "Esc" "Ctrl c" { SwitchToMode "Normal"; }
        // Ctrl-a Ctrl-a sends Ctrl-a to the program (start of line in zsh)
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Panes
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "|" "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "S" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "m" { SwitchToMode "Move"; }

        // Resizing: H/J/K/L resize once and stay in resize mode, so you can
        // keep pressing h/j/k/l (like `bind -r` in tmux). Esc leaves.
        bind "H" { Resize "Increase Left"; SwitchToMode "Resize"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "Resize"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "Resize"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "Resize"; }

        // Tabs (tmux windows)
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Ctrl h" "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Ctrl l" "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Scrollback
        bind "[" { SwitchToMode "Scroll"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }

        // Sessions (one per project, see `zp`)
        bind "d" { Detach; }
        bind "s" "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal";
        }
        bind "W" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal";
        }
        bind "P" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal";
        }
        bind "C" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal";
        }
        bind "?" {
            Run "zsh" "-c" "exec nvim -R ${XDG_CONFIG_HOME:-$HOME/.config}/zellij/cheatsheet.md" {
                floating true
                close_on_exit true
                name "cheat sheet"
            };
            SwitchToMode "Normal";
        }
        bind "q" { Quit; }
    }

    resize {
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "h" "H" "Left" { Resize "Increase Left"; }
        bind "j" "J" "Down" { Resize "Increase Down"; }
        bind "k" "K" "Up" { Resize "Increase Up"; }
        bind "l" "L" "Right" { Resize "Increase Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    move {
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "Tab" { MovePane; }
    }

    scroll {
        bind "Esc" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "G" { ScrollToBottom; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
    }

    search {
        bind "Esc" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "n" { Search "up"; }
        bind "N" { Search "down"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
    }

    entersearch {
        bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" "Ctrl c" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" "Ctrl c" { UndoRenamePane; SwitchToMode "Normal"; }
    }
}
