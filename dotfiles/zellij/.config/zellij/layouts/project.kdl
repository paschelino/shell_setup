// One session per project: nvim, a coding agent and a shell, each in its own
// tab. Started by the zsh function `zp`, which also picks the agent per
// project from the private project list (see README). `_zp_run` loads the
// project's direnv and mise environment, runs the command and falls back to a
// shell when it exits.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="nvim" focus=true {
        pane command="zsh" {
            args "-ic" "_zp_run nvim ."
        }
    }

    tab name="agent" {
        pane command="zsh" {
            args "-ic" "_zp_run _zp_agent"
        }
    }

    tab name="shell" {
        pane
    }
}
